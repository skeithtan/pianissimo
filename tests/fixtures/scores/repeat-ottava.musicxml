<?xml version="1.0" encoding="UTF-8"?>
<!-- An 8va bracket from bar 3 to the start of bar 6 across a repeat with endings, on a
     single-staff part: 1 |: 2 3 [1. 4 :| [2. 5 ] 6. Performance order 1 2 3 4 2 3 5 6 splits the
     bracket into three performed spans (bars 3–4, bar 3 pass 2, bar 5). -->
<score-partwise version="4.0">
  <work><work-title>Repeat With Ottava</work-title></work>
  <part-list><score-part id="P1"><part-name>Piano</part-name></score-part></part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <key><fifths>0</fifths></key>
        <time><beats>2</beats><beat-type>4</beat-type></time>
        <clef><sign>G</sign><line>2</line></clef>
      </attributes>
      <direction><direction-type><metronome><beat-unit>quarter</beat-unit><per-minute>60</per-minute></metronome></direction-type><sound tempo="60"/></direction>
      <note><pitch><step>C</step><octave>5</octave></pitch><duration>2</duration><voice>1</voice><type>half</type></note>
    </measure>
    <measure number="2">
      <barline location="left"><repeat direction="forward"/></barline>
      <note><pitch><step>D</step><octave>5</octave></pitch><duration>2</duration><voice>1</voice><type>half</type></note>
    </measure>
    <measure number="3">
      <direction placement="above"><direction-type><octave-shift type="down" size="8" number="1"/></direction-type></direction>
      <note><pitch><step>E</step><octave>6</octave></pitch><duration>2</duration><voice>1</voice><type>half</type></note>
    </measure>
    <measure number="4">
      <barline location="left"><ending number="1" type="start"/></barline>
      <note><pitch><step>F</step><octave>6</octave></pitch><duration>2</duration><voice>1</voice><type>half</type></note>
      <barline location="right"><ending number="1" type="stop"/><repeat direction="backward"/></barline>
    </measure>
    <measure number="5">
      <barline location="left"><ending number="2" type="start"/></barline>
      <note><pitch><step>G</step><octave>6</octave></pitch><duration>2</duration><voice>1</voice><type>half</type></note>
      <barline location="right"><ending number="2" type="stop"/></barline>
    </measure>
    <measure number="6">
      <direction placement="above"><direction-type><octave-shift type="stop" size="8" number="1"/></direction-type></direction>
      <note><pitch><step>C</step><octave>5</octave></pitch><duration>2</duration><voice>1</voice><type>half</type></note>
    </measure>
  </part>
</score-partwise>
